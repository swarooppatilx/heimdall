# Copy this file to .dev.vars for local development.
# .dev.vars is gitignored and is only read by local tooling,
# never by a production deployment.

# Secret that authorizes the local-only POST /api/crawl/trigger endpoint.
# Pick any value for local use. If this is absent, the trigger returns 401.
CRAWL_TRIGGER_TOKEN=change-me

# Optional. Canonical site URL for metadata, sitemap and llms-full.txt.
# Defaults to the production workers.dev URL; never derived from the request Host.
# NEXT_PUBLIC_SITE_URL=https://heimdall.example.dev