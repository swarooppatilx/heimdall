{
  "$schema": "node_modules/wrangler/config-schema.json",
  "keep_names": false,
  "name": "heimdall",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
  "upload_source_maps": true,
  "vars": {
    "FRESHNESS_DAYS": "15",
    "NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN": "30c1eed54e67440c8dce414f993f30aa"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heimdall",
      "database_id": "6b37f1bd-c8b0-403a-a09b-8bbf52eba642",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "18d7a6e62e0f4a0ab248982bb2faa2ce"
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "heimdall"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
