{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/route.ts",
    "src/app/**/{page,layout,error,global-error,not-found,manifest,robots,sitemap}.{ts,tsx}"
  ],
  "project": ["src/**/*.ts", "src/**/*.tsx", "worker/*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["shadcn", "tw-animate-css", "tailwindcss", "cloudflare"],
  "ignore": ["src/components/ui/**"]
}
